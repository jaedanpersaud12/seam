{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Seam",
  "version": "0.1.0",
  "identifier": "dev.seam.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Compare files and folders",
    "copyright": "\u00a9 2026 Jaedan Persaud",
    "publisher": "Jaedan Persaud",
    "homepage": "https://github.com/jaedanpersaud12/seam",
    "longDescription": "Seam compares files and folders side by side: patience diffs with word and character highlights, editable panes, folder trees, and a git difftool CLI.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
